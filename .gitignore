# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
dist/
bin/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# package manager — keep pnpm-lock.yaml committed for reproducible CI
package-lock.json
yarn.lock

# tsup build cache
.tsup/

# semantic-release
.nyc_output

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# flutter
.dart_tool
build
GoogleService-Info.plist

repomix-output.xml
.serena/cache

# Plans — ignore every direct child, then re-include the templates folder.
# (Can't use `plans/` because gitignore won't re-include children of an excluded dir.)
plans/*
!plans/templates
!plans/templates/**

screenshots/*
docs/screenshots/*
logs.txt
test-ck
__pycache__

# CK meta commands
prompt.md
ck.md

# .claude — ignore every direct child, then re-include the rules folder.
.claude/*
!.claude/rules
!.claude/rules/**

# Other AI tooling state (local-only, not for the repo)
.codex/
.gemini/
.agents/

# Editor / CI configs not tracked in this repo
.vscode/
.github/

# ...except the VSCode settings that ship with each starter template
# (ESLint auto-fix-on-save + recommended extensions).
!templates/*/.vscode/
!templates/*/.vscode/**

# Local-only state inside tracked claude source
claude/agent-memory/
claude/hooks/.logs/
claude/session-state/latest.md
claude/session-state/archive/
claude/settings.bak.json
claude/skills/ai-multimodal/assets/demo-*.claude/session-state/*.tmp

# Gemini CLI settings (symlink to staged .claude/.mcp.json)
.gemini/settings.json
# Showoff/marketing assets (images, showcases)
assets/
# Exception: use-mcp ships a persistent tool catalog at assets/tools.json
!claude/skills/use-mcp/assets/
!claude/skills/use-mcp/assets/**

# External repos for study/reference
external/

# Git worktrees (local development only)
worktrees/
# Gemini CLI settings (contains user-specific config)
.gemini/
