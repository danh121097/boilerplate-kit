{
  "cSpell.words": [
    "Centralised",
    "citty",
    "colour",
    "effectful",
    "giget",
    "languagedetector",
    "nypm",
    "refetched",
    "refetches",
    "smhd",
    "TSES",
    "Unclaimable",
    "vinxi"
  ],

  // --- ESLint: auto-fix (incl. perfectionist import sorting) on save ---
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.useFlatConfig": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact", "vue"],
  // Each template is its own project (own node_modules + eslint config).
  // "auto" makes ESLint resolve config/deps from the nearest package.json,
  // so files under templates/* are linted with that template's setup.
  "eslint.workingDirectories": [{ "mode": "auto" }],

  // --- Format on save (Prettier where available) ---
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode"
}
