VITE_APP_NAME=PRISM_APP
VITE_APP_ENDPOINT=http://localhost:3000
VITE_API_PREFIX=/api/v1
VITE_LANGUAGE_CODE=en
VITE_HMAC_SECRET=
VITE_BUILD_VERSION=
# Mock auth, dev only: log in without a backend while auth is not integrated yet.
# Only mocks login / register / refresh / logout / me; other APIs still call the real backend.
# Turned on only by exactly "true" or "1"; anything else is off. Ignored in production builds.
# Restart the dev server after changing these values.
# Use it on localhost only, never on a shared, staging or tunnelled dev server.
# Examples:
#   VITE_AUTH_MOCK=true                        # turn mock auth on
#   VITE_AUTH_MOCK_EMAIL=admin@myapp.dev       # change the demo account
#   VITE_AUTH_MOCK_PASSWORD=secret123          # at least 8 characters (login form rule)
VITE_AUTH_MOCK=true
VITE_AUTH_MOCK_EMAIL=demo@example.com
VITE_AUTH_MOCK_PASSWORD=password
