    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "postcss": "^8.5.3",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^3.0.0"
