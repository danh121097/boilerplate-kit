# API base URL for the MAIN backend service
NEXT_PUBLIC_API_BASE_URL=https://jsonplaceholder.typicode.com

# App name prefix used in localStorage keys (e.g. MYAPP_AUTH_TOKEN)
NEXT_PUBLIC_APP_NAME=NEXTJS_APP

# Default locale loaded on first visit ("en" | "ja")
NEXT_PUBLIC_LANGUAGE_CODE=en

# HMAC secret for request signing — must match the backend's verifyHmac secret.
# This is client-readable (public). For a stronger guarantee, move signing into
# a Route Handler and keep the secret server-side only.
NEXT_PUBLIC_HMAC_SECRET=

# Build version attached to every signed request as x-version
NEXT_PUBLIC_BUILD_VERSION=1.0.0

# Socket.IO server endpoint (leave empty to disable socket connection)
NEXT_PUBLIC_APP_ENDPOINT=
