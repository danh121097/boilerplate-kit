NEXT_PUBLIC_APP_NAME=PRISM_APP
NEXT_PUBLIC_APP_ENDPOINT=http://localhost:3000
NEXT_PUBLIC_API_PREFIX=/api/v1
NEXT_PUBLIC_LANGUAGE_CODE=en
# Required by the bundled backends; must equal the backend HMAC_SECRET.
# Empty means every request is rejected with 401 HMAC_ERROR (dev console warns once).
# It ships to the browser, so it is anti-abuse only, not a secret.
# Real backend checklist: NEXT_PUBLIC_AUTH_MOCK off, NEXT_PUBLIC_APP_ENDPOINT + NEXT_PUBLIC_API_PREFIX
# point at it, NEXT_PUBLIC_HMAC_SECRET = the backend HMAC_SECRET value.
NEXT_PUBLIC_HMAC_SECRET=
NEXT_PUBLIC_BUILD_VERSION=1.0.0
# Mock auth, dev only: log in without a backend while auth is not integrated yet.
# Only mocks login / register / refresh / logout / me; other APIs still call the real backend.
# Turned on only by exactly "true" or "1"; anything else is off. Ignored in production builds.
# Build-time variables: restart `next dev` after changing them.
# Use it on localhost only, never on a shared, staging or tunnelled dev server.
# Examples:
#   NEXT_PUBLIC_AUTH_MOCK=true                        # turn mock auth on
#   NEXT_PUBLIC_AUTH_MOCK_EMAIL=admin@myapp.dev       # change the demo account
#   NEXT_PUBLIC_AUTH_MOCK_PASSWORD=secret123          # any non-empty value (login form only requires non-empty)
NEXT_PUBLIC_AUTH_MOCK=true
NEXT_PUBLIC_AUTH_MOCK_EMAIL=demo@example.com
NEXT_PUBLIC_AUTH_MOCK_PASSWORD=password
