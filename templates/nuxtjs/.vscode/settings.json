{
  // Run ESLint auto-fix on every save: perfectionist import sorting +
  // local/sort-setup-declarations (role order in <script setup> and composables).
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  // Flat config (eslint.config.ts) + lint these languages so .vue files
  // surface ESLint warnings/errors inline.
  "eslint.useFlatConfig": true,
  "eslint.validate": ["javascript", "typescript", "vue"],
  // Prettier handles formatting; ESLint handles lint + declaration/import order.
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true
}
