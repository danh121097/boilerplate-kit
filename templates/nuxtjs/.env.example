NUXT_PUBLIC_APP_NAME=PRISM_APP
NUXT_PUBLIC_APP_ENDPOINT=http://localhost:3000
NUXT_PUBLIC_API_PREFIX=/api/v1
NUXT_PUBLIC_LANGUAGE_CODE=en
NUXT_PUBLIC_HMAC_SECRET=
NUXT_PUBLIC_BUILD_VERSION=1.0.0
# Mock auth, dev only: log in without a backend while auth is not integrated yet.
# Only mocks login / register / refresh / logout / me; other APIs still call the real backend.
# Turned on only by exactly "true" or "1"; anything else is off. Ignored in production builds.
# Maps to runtimeConfig.public.authMock / authMockEmail / authMockPassword. Restart `nuxt dev` after changing them.
# Use it on localhost only, never on a shared, staging or tunnelled dev server
# (the dev SSR server trusts the mock session cookie).
# Examples:
#   NUXT_PUBLIC_AUTH_MOCK=true                        # turn mock auth on
#   NUXT_PUBLIC_AUTH_MOCK_EMAIL=admin@myapp.dev       # change the demo account
#   NUXT_PUBLIC_AUTH_MOCK_PASSWORD=secret123          # at least 8 characters (login form rule)
NUXT_PUBLIC_AUTH_MOCK=true
NUXT_PUBLIC_AUTH_MOCK_EMAIL=demo@example.com
NUXT_PUBLIC_AUTH_MOCK_PASSWORD=password
