{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Listed explicitly: TypeScript 6 (e.g. the editor's bundled TS) no longer
    // auto-includes every @types package, so jest globals would be missing.
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["app", "src", "expo-env.d.ts", "nativewind-env.d.ts", ".expo/types/**/*.ts"]
}
