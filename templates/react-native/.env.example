EXPO_PUBLIC_APP_NAME=PRISM_APP
EXPO_PUBLIC_APP_ENDPOINT=http://localhost:3000
EXPO_PUBLIC_API_PREFIX=/api/v1
EXPO_PUBLIC_LANGUAGE_CODE=en
EXPO_PUBLIC_HMAC_SECRET=
EXPO_PUBLIC_BUILD_VERSION=
# Mock auth, dev only: log in without a backend while auth is not integrated yet.
# Only mocks login / register / refresh / logout / me; other APIs still call the real backend.
# Turned on only by exactly "true" or "1"; anything else is off. Ignored in release builds (!__DEV__).
# Restart Metro after changing them: npx expo start -c
# Examples:
#   EXPO_PUBLIC_AUTH_MOCK=true                        # turn mock auth on
#   EXPO_PUBLIC_AUTH_MOCK_EMAIL=admin@myapp.dev       # change the demo account
#   EXPO_PUBLIC_AUTH_MOCK_PASSWORD=secret123          # at least 8 characters (login form rule)
EXPO_PUBLIC_AUTH_MOCK=true
EXPO_PUBLIC_AUTH_MOCK_EMAIL=demo@example.com
EXPO_PUBLIC_AUTH_MOCK_PASSWORD=password
