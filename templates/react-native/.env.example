EXPO_PUBLIC_APP_NAME=PRISM_APP
EXPO_PUBLIC_APP_ENDPOINT=http://localhost:3000
EXPO_PUBLIC_API_PREFIX=/api/v1
EXPO_PUBLIC_LANGUAGE_CODE=en
# Required by the bundled backends; must equal the backend HMAC_SECRET. Shipped in the app bundle, so it is public.
EXPO_PUBLIC_HMAC_SECRET=
EXPO_PUBLIC_BUILD_VERSION=
# Real backend checklist: mock off (set EXPO_PUBLIC_AUTH_MOCK=false or remove it; this file ships it as true), endpoint + prefix match the backend,
# HMAC secret = backend value. Android emulator: http://10.0.2.2:3000; device: your LAN IP.
# Mock auth, dev only: log in without a backend while auth is not integrated yet.
# Only mocks /auth/* (login / register / refresh / logout / me) and /users; other APIs still call the real backend.
# Turned on only by exactly "true" or "1"; anything else is off. Ignored in release builds (!__DEV__).
# Restart Metro after changing them: npx expo start -c
# In dev, values in .env* files override shell-exported EXPO_PUBLIC_*. Put personal overrides in
# .env.development.local (gitignored): it wins over .env without editing it.
# Examples:
#   EXPO_PUBLIC_AUTH_MOCK=true                        # turn mock auth on
#   EXPO_PUBLIC_AUTH_MOCK_EMAIL=admin@myapp.dev       # change the demo account
#   EXPO_PUBLIC_AUTH_MOCK_PASSWORD=secret123          # any non-empty password (login form rule)
EXPO_PUBLIC_AUTH_MOCK=true
EXPO_PUBLIC_AUTH_MOCK_EMAIL=demo@example.com
EXPO_PUBLIC_AUTH_MOCK_PASSWORD=password
