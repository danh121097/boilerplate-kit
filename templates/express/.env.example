APP_NAME=PRISM_APP
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/express-starter

# Base path all API routes mount under
API_PREFIX=/api/v1

# CSRF Origin allow-list guard (mutating methods). Off by default — the
# same-origin reverse-proxy deploy closes CSRF via SameSite=strict. Turn on for
# defense-in-depth or split-domain deploys.
ENABLE_CSRF=false

# Cookie Domain for split-domain deploys (e.g. .example.com). Leave empty for
# host-only cookies (same-origin proxy — recommended default).
COOKIE_DOMAIN=

# JWT configuration — access tokens use the RSA keypair (RS256); refresh tokens
# use the HS256 symmetric secret below (refresh is only verified by this server).
JWT_PRIVATE_KEY_PATH=src/keys/rsa.private
JWT_PUBLIC_KEY_PATH=src/keys/rsa.public
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# HMAC secret for signing tokens
HMAC_SECRET=your-hmac-secret-change-in-production

# Redis (optional). Leave REDIS_ENABLED=false to run fully without Redis.
# Turning it on activates: distributed rate-limit store, cache helper,
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Reverse proxies in front of the app. Decides which client IP is used for rate
# limiting and logs (read from X-Forwarded-For). Invalid values fail startup.
#
# Examples:
#   TRUST_PROXY=                 # local dev, or the app is reached directly (default)
#   TRUST_PROXY=1                # behind one nginx / Caddy / Traefik / AWS ALB / Render / Railway / Fly.io
#   TRUST_PROXY=2                # Cloudflare -> nginx -> app
#   TRUST_PROXY=loopback         # nginx on the same host, proxying to 127.0.0.1
#   TRUST_PROXY=10.0.0.0/8       # only trust proxies inside the private network (e.g. k8s ingress)
#   TRUST_PROXY=10.0.0.0/8,127.0.0.1
#
# Avoid TRUST_PROXY=true: any client could fake its IP and bypass rate limits.
TRUST_PROXY=

# Logging threshold: debug | info | warn | error (defaults: info in prod, debug in dev)
LOG_LEVEL=

# Swagger UI + OpenAPI spec at /docs. Unset = on outside production, off in production.
# Set true to expose docs in production, false to hide them elsewhere.
DOCS_ENABLED=




