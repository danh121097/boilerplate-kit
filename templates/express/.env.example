APP_NAME=
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/express-starter
CORS_ORIGIN=http://localhost:5173
# Base path all API routes mount under
API_PREFIX=/api/v1

# JWT configuration
JWT_PRIVATE_KEY_PATH=src/keys/rsa.private
JWT_PUBLIC_KEY_PATH=src/keys/rsa.public
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# HMAC secret for signing tokens
HMAC_SECRET=your-hmac-secret-change-in-production

# Redis (optional). Leave REDIS_ENABLED=false to run fully without Redis.
# Turning it on activates: distributed rate-limit store, cache helper,
# and access-token revocation on logout.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Postman API configuration
POSTMAN_API_KEY=
POSTMAN_COLLECTION_UID=



