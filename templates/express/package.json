{
  "name": "node-ts-boilerplate",
  "version": "1.0.0",
  "description": "Node.js tutorial with TypeScript, Express, and MongoDB",
  "main": "dist/server.js",
  "scripts": {
    "predev": "[ -f src/keys/rsa.private ] || sh src/keys/setup.sh",
    "dev": "bun --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias",
    "build:swc": "swc src -d dist --config-file .swcrc && tsc-alias",
    "typecheck": "tsc --noEmit",
    "start": "bun dist/server.js",
    "start:node": "node dist/server.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postman:generate": "bun scripts/postman/sync.ts",
    "postman:watch": "bun --watch scripts/postman/sync.ts"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.1",
    "morgan": "^1.10.1",
    "rate-limit-redis": "^5.0.0",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.40",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.5.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.1.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "mongodb-memory-server": "^11.0.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.0"
  }
}
