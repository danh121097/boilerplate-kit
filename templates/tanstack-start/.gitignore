# routeTree.gen.ts is committed as a cold-typecheck stub.
# The TanStack Start Vite plugin regenerates it from src/routes/ on every
# dev/build run. Edit the stub only when adding/removing routes without running
# the dev server first; the real generated file will overwrite it on next build.
*.local
.DS_Store

# Lock files — the template ships PM-agnostic; commit yours after scaffolding.
pnpm-lock.yaml
package-lock.json
yarn.lock
bun.lockb
.tanstack

# env files
.env
.env.*
!.env.example

# unplugin-auto-import writes these on every dev/build. auto-imports.d.ts is
# COMMITTED as a cold-start stub (like routeTree.gen.ts) so `typecheck` works on a
# fresh checkout before the first dev/build; re-commit it only when the
# auto-imported surface changes. The eslintrc globals file stays local — the
# eslint config reads it only when present.
.eslintrc-auto-import.json
