VITE_APP_NAME=

# Backend base URL. When pointing at the Express template, include its API prefix
# so the refresh cookie path lines up, e.g. http://localhost:3000/api/v1
VITE_API_BASE_URL=https://jsonplaceholder.typicode.com
VITE_LANGUAGE_CODE=en

# HMAC request signing. The Express backend requires a signature on EVERY request,
# so this MUST equal the backend's HMAC_SECRET. Leave empty only when the backend
# does not enforce HMAC (e.g. the public demo API).
VITE_HMAC_SECRET=
VITE_BUILD_VERSION=

# Socket.IO server endpoint (e.g. http://localhost:3000). Leave empty to disable.
VITE_APP_ENDPOINT=
