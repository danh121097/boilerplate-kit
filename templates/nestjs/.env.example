APP_NAME=
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/nestjs-starter

# Base path all API routes mount under
API_PREFIX=/api/v1

# CSRF Origin allow-list guard (mutating methods). Off by default — the
# same-origin reverse-proxy deploy closes CSRF via SameSite=strict. Turn on for
# defense-in-depth or split-domain deploys.
ENABLE_CSRF=false

# Cookie Domain for split-domain deploys (e.g. .example.com). Leave empty for
# host-only cookies (same-origin proxy — recommended default).
COOKIE_DOMAIN=

# JWT configuration — access tokens use the RSA keypair (RS256); refresh tokens
# use the HS256 symmetric secret below (refresh is only verified by this server).
JWT_PRIVATE_KEY_PATH=src/keys/rsa.private
JWT_PUBLIC_KEY_PATH=src/keys/rsa.public
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# HMAC secret for signing requests
HMAC_SECRET=your-hmac-secret-change-in-production

# Redis (optional). Leave REDIS_ENABLED=false to run fully without Redis.
# Turning it on activates: distributed rate-limit store, cache helper,
# token revocation, and the Socket.IO Redis adapter (multi-instance fan-out).
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Logging threshold: debug | info | warn | error (defaults: info in prod, debug in dev)
LOG_LEVEL=
