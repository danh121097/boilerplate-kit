APP_NAME=PRISM_APP
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/fastify-starter

# All HTTP routes mount under this prefix.
API_PREFIX=/api/v1

# Optional Origin/Referer check for state-changing API requests.
ENABLE_CSRF=false
COOKIE_DOMAIN=

# Access JWTs use RS256 PEM keys. `pnpm keys` creates these files locally.
JWT_PRIVATE_KEY_PATH=src/keys/rsa.private
JWT_PUBLIC_KEY_PATH=src/keys/rsa.public
JWT_REFRESH_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# HMAC-SHA256 signature shared with trusted API clients.
HMAC_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional Redis features: distributed rate limits, cache, and access-token revocation.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Leave empty to trust no forwarded headers. Fastify accepts true/false or explicit IP/CIDR ranges.
# Examples: true, loopback, 10.0.0.0/8,127.0.0.1
TRUST_PROXY=

LOG_LEVEL=info
