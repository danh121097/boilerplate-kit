APP_NAME=PRISM_APP
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/fastify-starter

# All HTTP routes mount under this prefix.
API_PREFIX=/api/v1

# Optional Origin/Referer check for state-changing API requests. Requests with no
# Cookie, Origin or Referer header (native apps, server-to-server) are exempt.
ENABLE_CSRF=false
COOKIE_DOMAIN=

# Access JWTs use RS256 PEM keys. `pnpm keys` creates these files locally.
JWT_PRIVATE_KEY_PATH=src/keys/rsa.private
JWT_PUBLIC_KEY_PATH=src/keys/rsa.public
JWT_REFRESH_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Required. HMAC-SHA256 secret shared with API clients; must equal the secret the
# client signs with. Anti-abuse only: a secret shipped to a browser or app is public.
HMAC_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional Redis features: distributed rate limits, cache, and access-token revocation.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Reverse proxies in front of the app. Decides which client IP is used for rate
# limiting and logs (read from X-Forwarded-For). Invalid values fail startup.
#
# Examples:
#   TRUST_PROXY=                 # local dev, or the app is reached directly (default)
#   TRUST_PROXY=1                # behind one nginx / Caddy / Traefik / AWS ALB / Render / Railway / Fly.io
#   TRUST_PROXY=2                # Cloudflare -> nginx -> app
#   TRUST_PROXY=loopback         # nginx on the same host, proxying to 127.0.0.1
#   TRUST_PROXY=10.0.0.0/8       # only trust proxies inside the private network (e.g. k8s ingress)
#   TRUST_PROXY=10.0.0.0/8,127.0.0.1
#
# Avoid TRUST_PROXY=true: any client could fake its IP and bypass rate limits.
TRUST_PROXY=

# Logging threshold: debug | info | warn | error (defaults: info in prod, debug in dev)
LOG_LEVEL=

# Swagger UI + OpenAPI spec at /docs. Unset = on outside production, off in production.
# Set true to expose docs in production, false to hide them elsewhere.
DOCS_ENABLED=
