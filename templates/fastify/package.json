{
  "name": "fastify-starter",
  "version": "1.0.0",
  "description": "Fastify + TypeScript backend starter — JWT, HMAC, MongoDB, Redis, Socket.IO, Swagger",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "keys": "node scripts/ensure-keys.mjs",
    "predev": "node scripts/ensure-keys.mjs",
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit -p tsconfig.build.json && swc src -d dist --strip-leading-paths --config-file .swcrc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:redis": "vitest run -c vitest.redis.config.ts"
  },
  "keywords": [
    "nodejs",
    "fastify",
    "typescript",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.1",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.40",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.9.0",
    "mongodb-memory-server": "^11.0.1",
    "openapi-types": "^12.1.3",
    "prettier": "^3.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.57.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.0"
  }
}
